pragma solidity ^0.8.24;
import "./AtomicV3Executor.sol";
contract MockERC20 { string public name; mapping(address=>uint) public balanceOf; mapping(address=>mapping(address=>uint)) public allowance; uint public feeBps; constructor(string memory n){name=n;} function mint(address a,uint n) external {balanceOf[a]+=n;} function setFee(uint x) external {feeBps=x;} function approve(address s,uint n) external returns(bool){allowance[msg.sender][s]=n;return true;} function transfer(address t,uint n) external returns(bool){_x(msg.sender,t,n);return true;} function transferFrom(address f,address t,uint n) external returns(bool){uint a=allowance[f][msg.sender];require(a>=n,"allow");allowance[f][msg.sender]=a-n;_x(f,t,n);return true;} function _x(address f,address t,uint n) internal {require(balanceOf[f]>=n,"bal");balanceOf[f]-=n;balanceOf[t]+=n-(n*feeBps/10000);} }
contract MockFactory { mapping(bytes32=>address) public pools; function set(address a,address b,uint24 f,address p) external {pools[keccak256(abi.encode(a,b,f))]=p;} function getPool(address a,address b,uint24 f) external view returns(address){return pools[keccak256(abi.encode(a,b,f))];} }
contract MockRouter { bool public fail; uint public rate=1; function setFail(bool x) external {fail=x;} function setRate(uint x) external {rate=x;} function exactInputSingle(IV3Router.ExactInputSingleParams calldata p) external payable returns(uint out){require(!fail,"swap fail");MockERC20(p.tokenIn).transferFrom(msg.sender,address(this),p.amountIn);out=p.amountIn*rate;require(out>=p.amountOutMinimum,"min");MockERC20(p.tokenOut).mint(p.recipient,out);} function aggregate(address tokenIn,address tokenOut,address sender,address recipient,uint amountIn,uint minOut) external returns(uint out){require(!fail,"swap fail");require(sender==msg.sender,"sender");MockERC20(tokenIn).transferFrom(sender,address(this),amountIn);out=amountIn*rate;require(out>=minOut,"min");MockERC20(tokenOut).mint(recipient,out);} }
contract MockNPM { struct P {address owner;address t0;address t1;uint24 fee;int24 lo;int24 hi;uint128 liq;uint128 owed0;uint128 owed1;} mapping(uint=>P) public ps; mapping(address=>mapping(address=>bool)) public isApprovedForAll; uint public next=1; bool public failMint; function setFailMint(bool x) external {failMint=x;} function setApprovalForAll(address o,bool x) external {isApprovedForAll[msg.sender][o]=x;} function mint(IV3NPM.MintParams calldata m) external payable returns(uint id,uint128 l,uint a0,uint a1){require(!failMint,"mint fail");a0=m.amount0Desired-1;a1=m.amount1Desired-1;MockERC20(m.token0).transferFrom(msg.sender,address(this),a0);MockERC20(m.token1).transferFrom(msg.sender,address(this),a1);id=next++;l=uint128(a0+a1);ps[id]=P(m.recipient,m.token0,m.token1,m.fee,m.tickLower,m.tickUpper,l,0,0);}
function positions(uint id) external view returns(uint96,address,address,address,uint24,int24,int24,uint128,uint256,uint256,uint128,uint128){P memory p=ps[id];return(0,address(0),p.t0,p.t1,p.fee,p.lo,p.hi,p.liq,0,0,p.owed0,p.owed1);} function addFees(uint id,uint128 a0,uint128 a1) external {P storage p=ps[id];p.owed0+=a0;p.owed1+=a1;MockERC20(p.t0).mint(address(this),a0);MockERC20(p.t1).mint(address(this),a1);} function decreaseLiquidity(IV3NPM.DecreaseLiquidityParams calldata d) external payable returns(uint a0,uint a1){P storage p=ps[d.tokenId];require(msg.sender==p.owner||isApprovedForAll[p.owner][msg.sender],"nft approval");require(d.liquidity<=p.liq,"liq");p.liq-=d.liquidity;a0=d.liquidity/2;a1=d.liquidity-a0;p.owed0+=uint128(a0);p.owed1+=uint128(a1);MockERC20(p.t0).mint(address(this),a0);MockERC20(p.t1).mint(address(this),a1);} function collect(IV3NPM.CollectParams calldata c) external payable returns(uint a0,uint a1){P storage p=ps[c.tokenId];require(msg.sender==p.owner||isApprovedForAll[p.owner][msg.sender],"nft approval");a0=p.owed0<c.amount0Max?p.owed0:c.amount0Max;a1=p.owed1<c.amount1Max?p.owed1:c.amount1Max;p.owed0-=uint128(a0);p.owed1-=uint128(a1);MockERC20(p.t0).transfer(c.recipient,a0);MockERC20(p.t1).transfer(c.recipient,a1);} function burn(uint id) external payable {P storage p=ps[id];require(p.liq==0&&p.owed0==0&&p.owed1==0,"not empty");delete ps[id];} }
